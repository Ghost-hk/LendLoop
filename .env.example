# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (filled automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Comma-separated origins allowed to use Clerk sessions (dev hosts + prod URL)
CLERK_AUTHORIZED_PARTIES=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# n8n (docker-compose) — generate each secret with: openssl rand -hex 32
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Public base URL n8n is reached at (tunnel or domain), e.g. https://n8n.example.com/
N8N_PUBLIC_URL=
# HMAC secret for Convex -> n8n; set the same value in Convex: npx convex env set N8N_WEBHOOK_SECRET <value>
N8N_WEBHOOK_SECRET=
# HMAC secret for n8n -> Convex; set the same value in Convex: npx convex env set N8N_CONVEX_SECRET <value>
N8N_CONVEX_SECRET=
