      }
    },
    {
      "id": "a2",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst TOLERANCE_SECONDS = 300;\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nconst reject = (reason) => [{ json: { valid: false, reason } }];\n\nif (!secret) return reject('secret not configured');\nconst header = headers['x-lendloop-signature'] || '';\nconst parts = Object.fromEntries(header.split(',').map((p) => p.split('=', 2)));\nconst timestamp = Number(parts.t);\nif (!parts.v1 || !Number.isInteger(timestamp)) return reject('missing signature');\nif (Math.abs(Date.now() / 1000 - timestamp) > TOLERANCE_SECONDS) return reject('stale timestamp');\n\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${raw}`).digest();\nconst given = Buffer.from(parts.v1, 'hex');\nif (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return reject('bad signature');\n\nconst payload = JSON.parse(raw);\nif (headers['x-lendloop-delivery-id'] !== payload.deliveryId) return reject('delivery id mismatch');\n\nreturn [{ json: { valid: true, payload } }];\n"
      }
    },
    {
      "id": "a3",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
